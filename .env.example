# Copie este arquivo para ".env" e preencha.

# Nome do produto mostrado na interface (login, topo, aba e convites).
# Pra trocar a marca no futuro, é só mudar aqui e reiniciar.
APP_NOME=Estúdio de Posts

# Sua chave da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Chave que protege os logins. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Sua conta de dono (criada sozinha na primeira vez que o app sobe).
# Depois do primeiro login, pode apagar a senha daqui.
DONO_NOME=
DONO_EMAIL=
DONO_SENHA_INICIAL=

# Só no servidor: nome da rede Docker do proxy reverso (docker network ls)
PROXY_NETWORK=

# 1 quando estiver online com HTTPS (cookie de login só trafega criptografado).
# Deixe 0 no seu computador (localhost).
COOKIE_SEGURO=0

# Limites padrão pra novos convidados (dá pra mudar pessoa por pessoa no painel)
LIMITE_POSTS_MES_PADRAO=60
LIMITE_RADAR_MES_PADRAO=12

# Só pra estimar o custo de IA no painel. Confira em https://www.anthropic.com/pricing
PRECO_ENTRADA_USD_MTOK=3
PRECO_SAIDA_USD_MTOK=15
PRECO_BUSCA_USD=0.01
COTACAO_DOLAR=5.50
