# Copie este arquivo para ".env" e preencha.

# Nome do produto mostrado na interface (login, topo, aba e convites).
# Pra trocar a marca no futuro, é só mudar aqui e reiniciar.
APP_NOME=Estúdio de Posts

# Assinaturas pelo Asaas (em branco = cobrança desligada; convites seguem manuais)
# ATENÇÃO: a chave do Asaas começa com "$". Coloque entre aspas SIMPLES,
# senão o Docker apaga a chave: ASAAS_API_KEY='$aact_...'
ASAAS_API_KEY=
# sandbox (testes, sem dinheiro de verdade) ou producao
ASAAS_AMBIENTE=sandbox
# Senha do webhook (mínimo 32 caracteres). A mesma vai no cadastro do webhook no Asaas.
ASAAS_WEBHOOK_TOKEN=
# Preços mensais (R$). PRECO_* = preço cheio; PRECO_FUNDADOR_* = preço de
# fundador, oferecido enquanto houver vagas (FUNDADOR_VAGAS; 0 = sem fundador).
# O valor fica travado na assinatura de cada pessoa.
PRECO_ESSENCIAL=147
PRECO_COMPLETO=197
PRECO_FUNDADOR_ESSENCIAL=97
PRECO_FUNDADOR_COMPLETO=147
FUNDADOR_VAGAS=30
# Plano anual = MESES_ANUAL x preço mensal (10 = 2 meses grátis)
MESES_ANUAL=10
DIAS_TOLERANCIA=3

# Publicação automática no Instagram (plano Completo), via Zernio.
# Crie a chave em https://zernio.com/dashboard/api-keys. Em branco = recurso desligado.
ZERNIO_API_KEY=

# Sua chave da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Chave que protege os logins. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Sua conta de dono (criada sozinha na primeira vez que o app sobe).
# Depois do primeiro login, pode apagar a senha daqui.
DONO_NOME=
DONO_EMAIL=
DONO_SENHA_INICIAL=

# Só no servidor: nome da rede Docker do proxy reverso (docker network ls)
PROXY_NETWORK=

# 1 quando estiver online com HTTPS (cookie de login só trafega criptografado).
# Deixe 0 no seu computador (localhost).
COOKIE_SEGURO=0

# Limites padrão pra novos convidados (dá pra mudar pessoa por pessoa no painel)
LIMITE_POSTS_MES_PADRAO=60
LIMITE_RADAR_MES_PADRAO=12
# Sugestões automáticas de temas/público por IA, por convidado, por mês
LIMITE_SUGESTAO_AREA_MES=10

# Só pra estimar o custo de IA no painel. Confira em https://www.anthropic.com/pricing
PRECO_ENTRADA_USD_MTOK=3
PRECO_SAIDA_USD_MTOK=15
PRECO_BUSCA_USD=0.01
COTACAO_DOLAR=5.50
